# PhytoVeyra AI - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# NEVER commit your actual .env file to version control

# Application Mode
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=info

# Database (PostgreSQL / PostGIS / pgvector)
# For local development without Postgres running, SQLite fallback is enabled automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/phytoveyra
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=phytoveyra

# Authentication / Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# AI Services Providers
# Options: openai, gemini
AI_PROVIDER=openai
AI_API_KEY=your_openai_or_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# External Services
WEATHER_API_KEY=your_weather_api_key_here
MAPS_API_KEY=your_maps_api_key_here

# Object Storage (S3 / MinIO / Local)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=phytoveyra-scans

# Speech to Text & Text to Speech (Sarvam AI)
SARVAM_API_KEY=your_sarvam_api_key_here
STT_API_KEY=your_stt_api_key_here
TTS_API_KEY=your_tts_api_key_here

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# App Ports
PORT=8000
WEB_PORT=3000
